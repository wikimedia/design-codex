{
	"compilerOptions": {
		"target": "es2017",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"lib": [ "es2017", "dom" ],
		"types": [ "jest" ],
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.js",
		"src/**/*.mjs",
		"tests/**/*.ts",
		".jest/**/*.js",
		"./*.js",
		"./.*.js",
		"./*.mjs",
		"./*.ts",
		"./*.d.ts",
		"build/**/*.js"
	]
}
