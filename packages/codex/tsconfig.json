{
	"compilerOptions": {
		"target": "esnext",
		"useDefineForClassFields": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "preserve",
		"sourceMap": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowJs": true,
		"checkJs": true,
		"lib": [ "esnext", "dom" ],
		"types": [ "vitest/globals" ],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.vue",
		"build/**/*.ts",
		"build/**/*.mjs",
		"demos/**/*.ts",
		"./*.ts",
		"./*.js",
		"./*.mjs"
	],
	"exclude": [ "cypress.config.ts" ]
}
