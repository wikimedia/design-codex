{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationDir": "dist/types"
	},
	"include": [ "src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue" ],
	"exclude": [
		"src/**/*.test.ts",
		"src/**/*.snap.ts",
		"src/testutils",
		"src/demo",
		"src/start.ts",
		"src/lib-wip.ts",
		"src/components-wip",
		"src/messages.ts"
	]
}
