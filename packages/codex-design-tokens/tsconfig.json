{
	"compilerOptions": {
		"target": "esnext",
		"useDefineForClassFields": true,
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"strict": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"lib": [ "esnext", "dom" ],
		"types": [ "node", "vitest/globals" ],
		"skipLibCheck": true,
		"outDir": "dist",
		"allowJs": true,
		"checkJs": true
	},
	"include": [
		".style-dictionary/**/*.js",
		".style-dictionary/**/*.d.ts",
		"tests/**/*.js",
		"vitest.config.js"
	]
}
